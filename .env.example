# Public-facing frontend URL used to build links inside transactional emails
# (password-reset, invitations, etc.). In production set to the real domain
# (e.g. https://bryanrealstate.com). FRONT_URL is the primary variable;
# FRONTEND_URL is also accepted for backward compatibility.
FRONT_URL="http://localhost:5173"
# FRONTEND_URL="http://localhost:5173"

# Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/realestate_db?schema=public"

# Authentication (JWT)
JWT_SECRET="super-secret-key-change-this"
JWT_EXPIRATION="1d"

# AWS S3 (File Storage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_BUCKET_NAME="your-bucket-name"

# Upload limits & S3 timeouts (optional)
# MAX_UPLOAD_MB=10
# MAX_BODY_LIMIT_MB=20
# AWS_REQUEST_TIMEOUT_MS=1200000
# AWS_SOCKET_TIMEOUT_MS=1200000
# AWS_CONNECTION_TIMEOUT_MS=60000
# HTTP_TIMEOUT_MS=1800000
# HTTP_KEEPALIVE_TIMEOUT_MS=120000
# HTTP_HEADERS_TIMEOUT_MS=130000

# Mail Configuration (Optional)
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="user@example.com"
MAIL_PASSWORD="password"
MAIL_FROM="noreply@example.com"
MAIL_FROM_NAME="Bryan RealState"
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_IGNORE_TLS=false
MAIL_TLS_REJECT_UNAUTHORIZED=true

# Company Config
COMPANY_NAME="Inmobiliaria Bryan"

# Google Contacts Sync
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_SCOPE="https://www.googleapis.com/auth/contacts"
CONTACTS_SYNC_CRON="0 */6 * * *"
# Daily job that force-refreshes the Google access token even when the app
# is idle, so the refresh_token doesn't go stale from lack of use.
GOOGLE_TOKEN_KEEPALIVE_CRON="0 3 * * *"

# n8n Agent Router
# Base URL only. The backend appends /agent-http-router automatically.
# OBSOLETO: el backend ya no llama a n8n para recomendaciones (ahora usa OpenAI directo, ver AI_RECOMMENDATION_*).
# N8N_RECOMMENDER_* y N8N_JWT_* se conservan solo si otro flujo los necesita.
N8N_RECOMMENDER_URL="https://n8n.ecuadev.com/webhook-test"
N8N_RECOMMENDER_TIMEOUT_MS=12000

# n8n JWT Authentication
N8N_JWT_SECRET="secure-key"
N8N_JWT_ALGORITHM="HS256"
N8N_JWT_EXPIRES_IN=""

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# Scheduler: AI recommendations -> property_interests
# Default: every 5 hours (minute 0, hours divisible by 5). Standard 5-field cron.
RECOMMENDER_SYNC_ENABLED=true
RECOMMENDER_SYNC_CRON="0 */5 * * *"
RECOMMENDER_SYNC_TZ="America/Guayaquil"
# Rate limit del login (intentos por IP dentro de la ventana)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_MS=60000
# Saltos de proxy de confianza (nginx) para obtener la IP real del cliente
TRUST_PROXY=1

# Gasto de OpenAI del mes en el header. La API key normal NO puede leerlo:
# se necesita una Admin Key con permiso "Usage API" (platform.openai.com > Settings > Admin keys).
OPENAI_ADMIN_KEY="your-admin-key"
OPENAI_API_KEY="your-openai-api-key"# Modelo GPT (ver src/ai/ai.config.ts)
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_TEMPERATURE=0
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2

# Normalización de contactos nuevos de Google y botón "Normalizar con IA"
AI_CONTACT_PARSER_ENABLED=true
AI_CONTACT_PARSER_CONCURRENCY=4
AI_DEFAULT_PHONE_COUNTRY="EC"
# Descripciones públicas de propiedades con IA
AI_PROPERTY_DESCRIPTION_ENABLED=true
AI_PROPERTY_DESCRIPTION_AUTO_ON_SAVE=true
OPENAI_DESCRIPTION_TEMPERATURE=0.4
OPENAI_DESCRIPTION_MAX_OUTPUT_TOKENS=1500
# Recomendación de clientes con IA (directo a OpenAI, sin n8n)
AI_RECOMMENDATION_ENABLED=true
# OPENAI_RECOMMENDATION_MODEL= (por defecto OPENAI_MODEL)
OPENAI_RECOMMENDATION_TEMPERATURE=0
OPENAI_RECOMMENDATION_MAX_OUTPUT_TOKENS=2000
OPENAI_RECOMMENDATION_TIMEOUT_MS=60000
AI_RECOMMENDATION_BATCH_SIZE=120
AI_RECOMMENDATION_MIN_SCORE=60
